{
  "name": "fact-checker",
  "version": "1.0.0",
  "description": "Backend for fact-checking web application using Google Fact Check Tools API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "react-scripts build",
    "dev": "nodemon server.js",
    "test": "jest --watchAll --detectOpenHandles",
    "test:ci": "jest --ci --runInBand --detectOpenHandles",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky install",
    "docker:build": "docker build -t fact-checker .",
    "docker:run": "docker run -p 5000:5000 -d fact-checker",
    "docker:compose": "docker-compose up -d",
    "docker:compose:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "swagger": "node ./utils/generateSwagger.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "http-errors": "^2.0.0",
    "memory-cache": "^0.2.0",
    "mongoose": "^8.1.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^4.1.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.0.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/",
      "/utils/",
      "/config/"
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "fact-checking",
    "nodejs",
    "express",
    "mongodb",
    "google-fact-check-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khalifa-pendrops/factcheck.git"
  },
  "bugs": {
    "url": "https://github.com/Khalifa-pendrops/fact-checker/issues"
  },
  "homepage": "https://github.com/Khalifa-pendrops/fact-checker#readme"
}
